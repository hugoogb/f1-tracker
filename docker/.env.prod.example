# F1 Tracker — the app-specific half of /srv/apps/f1_api/.env
#
# new-app.sh already created that file with the platform's own keys — most
# importantly DATABASE_URL (through PgBouncer) and DIRECT_URL (straight to
# PostgreSQL). Do not replace it; append the settings below to it:
#
#   cat >> /srv/apps/f1_api/.env    # then paste, or scp this file's contents
#   chmod 600 /srv/apps/f1_api/.env
#
# Read by compose.yaml (shipped from docker/compose.prod.yml on every deploy)
# and by ingest.sh. Never commit the filled-in copy.

# --- Provided by new-app.sh — shown here only so the wiring is legible --------
# The API talks to PgBouncer; migrations and the ingest job use DIRECT_URL,
# because transaction pooling cannot carry a migration and a multi-minute ingest
# has no business holding a pooled connection.
#DATABASE_URL=postgresql://f1_api:...@pgbouncer:6432/f1_api
#DIRECT_URL=postgresql://f1_api:...@postgres:5432/f1_api

# --- Networking ----------------------------------------------------------------
# REQUIRED. The Docker network PostgreSQL and PgBouncer are on. This stack joins
# it, which is what makes the hostnames in DATABASE_URL/DIRECT_URL resolve from
# inside the container. Find it on the box with:
#
#   docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' postgres
#
SHARED_NETWORK=

# --- API ----------------------------------------------------------------------
# REQUIRED. The Vercel origin(s) allowed to call this API, comma-separated.
# No trailing slash. Include a custom domain here too if you have one.
CORS_ORIGINS=https://f1-tracker-web.vercel.app

FASTAPI_DEBUG=false
API_WORKERS=2

# Where the API listens on the host, for the platform's Caddy to forward to.
# Keep the loopback bind — Caddy terminates TLS. Pick a port no other app on
# this VPS uses.
API_BIND=127.0.0.1
API_PORT=8000

API_MEMORY_LIMIT=1g

# Override only to deploy an image from somewhere other than this repo's GHCR
# package. TAG is not set here — the deploy writes it to .tag.
#IMAGE_REPO=ghcr.io/hugoogb/f1_api

# --- Data sources -------------------------------------------------------------
# The f1db release the ingest job pulls. 'latest' tracks the newest release and
# is re-fetched every run; pin a tag (e.g. v2026.5.0) to freeze the dataset.
# The download is cached in the f1_api_f1db_cache volume.
F1DB_VERSION=latest

# --- Frontend cache purge -----------------------------------------------------
# ingest.sh POSTs here after a successful ingest so Vercel drops its cached
# pages. REVALIDATE_SECRET must match the Vercel environment variable.
REVALIDATE_URL=https://f1-tracker-web.vercel.app/api/revalidate
REVALIDATE_SECRET=
