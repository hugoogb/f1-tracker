# F1 Tracker — VPS backend environment.
#
#   cp docker/.env.prod.example .env.prod   # at the repo root on the VPS
#   chmod 600 .env.prod                     # it holds the database password
#
# Read by docker/compose.prod.yml and by scripts/vps/*.sh. Never commit the
# filled-in copy: .env.prod is gitignored.

# --- Stack identity -----------------------------------------------------------
# Prefixes the compose project, containers (f1-tracker-api, f1-tracker-db),
# volumes and the internal network, so this stack never collides with the other
# projects on this VPS. Change it to run a second copy (e.g. f1-tracker-staging).
STACK_NAME=f1-tracker
IMAGE_TAG=latest

# --- Database -----------------------------------------------------------------
# The container is not published to the host; only the API reaches it, over the
# project's internal Docker network.
POSTGRES_DB=f1tracker
POSTGRES_USER=f1tracker
# REQUIRED. Generate one: openssl rand -base64 32 | tr -d '/+=' | head -c 40
# Stick to alphanumerics — the value is interpolated into a URL below.
POSTGRES_PASSWORD=

# Optional: set only to point the API at a database outside this stack.
# Left unset, compose builds postgresql://$POSTGRES_USER:...@db:5432/$POSTGRES_DB.
#DATABASE_URL=

# --- API ----------------------------------------------------------------------
# REQUIRED. The Vercel origin(s) allowed to call this API, comma-separated.
# No trailing slash. Include a custom domain here too if you have one.
CORS_ORIGINS=https://f1-tracker-web.vercel.app

FASTAPI_DEBUG=false
API_WORKERS=2

# Where the API listens on the host, for a host reverse proxy (Caddy/nginx) to
# forward to. Keep the loopback bind — the proxy terminates TLS. Pick a port no
# other project on this VPS uses.
API_BIND=127.0.0.1
API_PORT=8000

# --- Traefik (only when using docker/compose.traefik.yml) ---------------------
# The API's public hostname, the shared external proxy network, and the Traefik
# entrypoint/cert resolver names from your Traefik config.
#API_DOMAIN=f1-api.example.com
#PROXY_NETWORK=edge
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt

# --- Resource limits ----------------------------------------------------------
# This VPS is shared with other projects; cap what this stack can take.
DB_MEMORY_LIMIT=1g
API_MEMORY_LIMIT=1g

# --- Frontend cache purge -----------------------------------------------------
# scripts/vps/ingest.sh POSTs here after a successful ingest so Vercel drops its
# cached pages. REVALIDATE_SECRET must match the Vercel environment variable.
REVALIDATE_URL=https://f1-tracker-web.vercel.app/api/revalidate
REVALIDATE_SECRET=

# --- One-time migration -------------------------------------------------------
# Only needed while moving data off Neon (scripts/vps/migrate-from-neon.sh).
# Delete it once the migration is done.
#NEON_DATABASE_URL=
