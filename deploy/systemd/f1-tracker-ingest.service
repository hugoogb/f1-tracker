# F1 Tracker — weekly data ingest.
#
# The database lives on the VPS and is not reachable from GitHub's runners, so
# ingestion runs here rather than in CI.
#
# Install:
#   sudo cp deploy/systemd/f1-tracker-ingest.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now f1-tracker-ingest.timer
#
# ingest.sh is placed in the app directory by the deploy workflow, so this unit
# only runs after the app has been deployed at least once. The unit name is
# project-prefixed so it is obvious which app it belongs to among the other
# stacks on this VPS.
[Unit]
Description=F1 Tracker data ingest
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=hugo
Group=docker
WorkingDirectory=/srv/apps/f1_api
ExecStart=/srv/apps/f1_api/ingest.sh
# Ingesting a race weekend downloads the f1db release and Fast-F1 sessions;
# give it room.
TimeoutStartSec=5400
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
