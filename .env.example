# Database (local Docker PostgreSQL)
DATABASE_URL=postgresql://f1tracker:f1tracker_dev@localhost:5432/f1tracker

# Neon (production) — used by scripts/update-neon.sh and the scheduled ingest workflow.
# Full form includes the SSL param: postgresql://user:pass@ep-xyz.region.aws.neon.tech/f1tracker?sslmode=require
NEON_DATABASE_URL=

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=true

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Fast-F1
FASTF1_CACHE_DIR=.fastf1_cache

# Next.js (baked into the bundle at build time — set before `pnpm build`)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
