# Local development environment.
# Copy to .env (scripts/bootstrap.sh does this for you). The VPS uses a separate
# file — see docker/.env.prod.example.

# --- Stack identity -----------------------------------------------------------
# Names the compose project, containers, volumes and network. Keeps this project
# distinguishable from the other Docker projects on the same machine, and is what
# scripts/lib/db.sh uses to find the database container (${STACK_NAME}-db).
STACK_NAME=f1-tracker

# --- Database (local Docker PostgreSQL) ---------------------------------------
POSTGRES_DB=f1tracker
POSTGRES_USER=f1tracker
POSTGRES_PASSWORD=f1tracker_dev
DB_BIND=127.0.0.1
DB_PORT=5432
DATABASE_URL=postgresql://f1tracker:f1tracker_dev@localhost:5432/f1tracker

# --- FastAPI ------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
# Also gates /docs, /redoc and /openapi.json. Keep false in production.
FASTAPI_DEBUG=true

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Fast-F1 ------------------------------------------------------------------
FASTF1_CACHE_DIR=.fastf1_cache

# --- Next.js (baked into the bundle at build time — set before `pnpm build`) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Shared secret for POST /api/revalidate (cache purge). Must match the Vercel env
# var and the value in the VPS .env.prod used by scripts/vps/ingest.sh.
REVALIDATE_SECRET=
REVALIDATE_URL=https://f1-tracker-web.vercel.app/api/revalidate
